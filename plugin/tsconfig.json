{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["react"],
    "typeRoots": ["../tooling/node_modules/@types"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "paths": {
      "elkjs/*": ["../tooling/node_modules/elkjs/*"],
      "lz-string": ["../tooling/node_modules/lz-string"]
    }
  },
  "include": [".claude-plugin/types", "src", "types"]
}
