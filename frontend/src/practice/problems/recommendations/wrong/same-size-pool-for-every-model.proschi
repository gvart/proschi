# expect-fail: p99 of Load Explore < 300 ms
# expect-fail: survive any node failure
# mistake: Giving every ranking pass the same number of machines
# explain: The funnel is right, but ten machines each is a guess: the distilled pool idles at half load while the deep model's 50k scores a second fill its ten machines to the brim, so requests queue there and the p99 blows up.
# explain: Size each pool from its own numbers: items per request times requests a second, divided by what one machine scores, then add headroom for a lost machine.
# lesson: sizing-each-pass
# cards: recommendations-heavy-model-load, media-processing-separate-pools, servers-for-peak-load
# The reference funnel with ten machines per ranking pass.
import "problem.proschi"

explore    "Explore API"         [gRPC]          x3 @serving "Runs the funnel for one request"
retrieval  "Candidate Retrieval" [Service]       x3 @serving "Samples 500 eligible posts from similar accounts"
embeddings "Account Embeddings"  [Search Engine] x2 @serving "Nearest-neighbour index over account embeddings"
features   "Feature Store"       [Redis]         x2 @serving "Precomputed features"
light      "First-pass Ranker"   [gRPC]          x10 @ranking "Distilled model: 500 down to 150"
medium     "Second-pass Ranker"  [gRPC]          x10 @ranking "Lightweight network: 150 down to 50"
heavy      "Final Ranker"        [gRPC]          x10 @ranking "Deep network: 50 down to 25"

user      -> explore    : HTTPS
explore   -> retrieval  : gRPC
retrieval -> embeddings : KNN query
explore   -> features   : MGET
explore   -> light      : gRPC
explore   -> medium     : gRPC
explore   -> heavy      : gRPC
pipeline  -> warehouse  : SQL
pipeline  -> features   : bulk load
pipeline  -> embeddings : bulk load

usecase "Load Explore" "A user opens Explore and gets 25 ranked posts" {
  user        -> explore    : GET /explore
  explore     -> retrieval  : GET candidates for the user
  retrieval   -> embeddings : KNN accounts near the user's seed accounts
  embeddings --> retrieval  : similar accounts
  retrieval  --> explore    : 500 eligible posts from those accounts
  explore     -> features   : MGET features of 500 posts and of the user
  features   --> explore    : features
  explore     -> light      : x500 SCORE with the distilled model
  light      --> explore    : best 150
  explore     -> medium     : x150 SCORE with the lightweight network
  medium     --> explore    : best 50
  explore     -> heavy      : x50 SCORE with the deep network
  heavy      --> explore    : best 25, ordered by expected value
  explore    --> user       : 200 page of 25 posts
}

usecase "Refresh features" "The offline pipeline loads fresh features and embeddings in batches" {
  pipeline    -> warehouse  : SELECT a batch of recent interactions
  warehouse  --> pipeline   : rows
  pipeline    -> features   : MSET features of a batch of posts
  pipeline    -> embeddings : UPSERT a batch of account embeddings
  embeddings --> pipeline   : ok
}
