# expect-fail: cost ≤ $20,000/month
# mistake: Running every ranking pass over all 500 candidates
# explain: The three passes are in the right order, but each one scores the full 500, so the earlier passes save the later ones nothing: the deep model still makes 500k predictions a second and its pool alone costs several times the budget.
# explain: Each pass should keep only its best: 500 to 150, 150 to 50, 50 to 25. Then the heavy pool is sized for 50 items a request, not 500.
# lesson: the-ranking-funnel
# cards: recommendations-ranking-funnel, recommendations-heavy-model-load, fanout-write-amplification
# Three passes that re-rank the same 500 posts, each pool sized to keep up.
import "problem.proschi"

explore    "Explore API"         [gRPC]          x3 @serving "Runs retrieval, reads features and calls the rankers"
retrieval  "Candidate Retrieval" [Service]       x3 @serving "Samples 500 eligible posts from similar accounts"
embeddings "Account Embeddings"  [Search Engine] x2 @serving "Nearest-neighbour index over account embeddings"
features   "Feature Store"       [Redis]         x2 @serving "Precomputed features"
light      "First-pass Ranker"   [gRPC]          x8 @ranking "Distilled model, scores all 500"
medium     "Second-pass Ranker"  [gRPC]          x30 @ranking "Lightweight network, re-scores all 500"
heavy      "Final Ranker"        [gRPC]          x120 @ranking "Deep network, re-scores all 500"

user      -> explore    : HTTPS
explore   -> retrieval  : gRPC
retrieval -> embeddings : KNN query
explore   -> features   : MGET
explore   -> light      : gRPC
explore   -> medium     : gRPC
explore   -> heavy      : gRPC
pipeline  -> warehouse  : SQL
pipeline  -> features   : bulk load
pipeline  -> embeddings : bulk load

usecase "Load Explore" "Every pass re-scores the same 500 candidates" {
  user        -> explore    : GET /explore
  explore     -> retrieval  : GET candidates for the user
  retrieval   -> embeddings : KNN accounts near the user's seed accounts
  embeddings --> retrieval  : similar accounts
  retrieval  --> explore    : 500 eligible posts from those accounts
  explore     -> features   : MGET features of 500 posts and of the user
  features   --> explore    : features
  explore     -> light      : x500 SCORE with the distilled model
  light      --> explore    : 500 scored
  explore     -> medium     : x500 SCORE with the lightweight network
  medium     --> explore    : 500 scored
  explore     -> heavy      : x500 SCORE with the deep network
  heavy      --> explore    : best 25
  explore    --> user       : 200 page of 25 posts
}

usecase "Refresh features" "The offline pipeline loads fresh features and embeddings in batches" {
  pipeline    -> warehouse  : SELECT a batch of recent interactions
  warehouse  --> pipeline   : rows
  pipeline    -> features   : MSET features of a batch of posts
  pipeline    -> embeddings : UPSERT a batch of account embeddings
  embeddings --> pipeline   : ok
}
