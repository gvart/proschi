# expect-fail: A purge clears the upper tier before the edge
# mistake: Purging the edge before the upper tier
# explain: Between the two purges an edge miss can refill the old asset from the upper tier, which still has it, so the stale copy survives the purge. Purge from the origin outward: the upper tier first, then the edges.
# lesson: purge-ordering-in-a-hierarchy
# cards: cdn-cache-control, fingerprinted-assets
# The edge is purged first: an edge miss before the upper tier is purged refills the old asset from it.
import "problem.proschi"

edge  "Edge Data Centers" [Cloudflare] x2 @cdn
upper "Upper Tier"        [Cloudflare] x2 @cdn
purge "Purge API"         [REST API]   x2 @cdn

visitor -> edge   : HTTPS
edge    -> upper  : cache fill
upper   -> origin : HTTPS
owner   -> purge  : HTTPS
purge   -> upper  : purge
purge   -> edge   : purge

usecase "Fetch asset" "A visitor requests a cacheable asset" {
  visitor -> edge : GET /assets/hero.jpg

  alt "Edge hit" {
    edge --> visitor : 200 cached
  } alt "Upper-tier hit" {
    edge   -> upper   : GET /assets/hero.jpg
    upper --> edge    : 200 cached
    edge  --> visitor : 200
  } alt "Upper-tier miss" {
    edge    -> upper   : GET /assets/hero.jpg
    upper   -> origin  : GET /assets/hero.jpg
    origin --> upper   : 200 Cache-Control max-age=86400
    upper  --> edge    : 200
    edge   --> visitor : 200
  }
}

usecase "Purge" "The site owner purges a changed asset" {
  owner  -> purge : POST /purge_cache json {"files": ["https://example.com/assets/hero.jpg"]}
  purge  -> edge  : x300 DELETE /assets/hero.jpg
  edge  --> purge : purged
  purge  -> upper : DELETE /assets/hero.jpg
  upper --> purge : purged
  purge --> owner : 200 {"success": true}
}
