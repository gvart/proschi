# expect-fail: Concurrent reads of one channel share one query
# Data services in front of ScyllaDB, but each request runs its own query: the busy partition gets every read.
import "problem.proschi"

data "Data Services" [Rust] x48 @data "One gRPC endpoint per query"

api  -> data     : gRPC
data -> messages : CQL
data -> hot      : CQL

usecase "Send message" "A user posts a message to a channel" {
  api       -> data     : SendMessage(channel 1046, "gg")
  data      -> messages : x3 INSERT INTO messages (channel_id, bucket, message_id) at QUORUM
  messages --> data     : ok
  data     --> api      : message 1129
}

usecase "Read messages" "A user opens an ordinary channel and loads its latest messages" {
  api       -> data     : GetMessages(channel 2210, limit 50)
  data      -> messages : x2 SELECT FROM messages WHERE channel_id = 2210 AND bucket = 1912 LIMIT 50 at QUORUM
  messages --> data     : 50 rows
  data     --> api      : 50 messages
}

usecase "Read busy channel" "Everyone in a huge server opens the channel that was just pinged" {
  api -> data : GetMessages(channel 1046, limit 50)

  alt "Joined in-flight read" when "a query for this channel is already running" {
    data  -> hot  : x2 SELECT FROM messages WHERE channel_id = 1046 AND bucket = 1912 LIMIT 50 at QUORUM
    hot  --> data : 50 rows
    data --> api  : 50 messages
  } alt "First read" when "no query for this channel is in flight" {
    data  -> hot  : x2 SELECT FROM messages WHERE channel_id = 1046 AND bucket = 1912 LIMIT 50 at QUORUM
    hot  --> data : 50 rows
    data --> api  : 50 messages
  }
}
