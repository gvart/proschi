# expect-fail: A message is stored before the sender hears back
# mistake: Answering the sender before the message is stored
# explain: A crash between the answer and the write loses a message the sender already saw as sent. Write the message to ScyllaDB first and answer once the write has succeeded.
# lesson: common-mistakes
# cards: ack-after-store, write-ahead-log
# The data service answers the sender first and writes ScyllaDB afterwards: a crash in between loses a message the sender saw as sent.
import "problem.proschi"

data "Data Services" [Rust] x48 @data "One gRPC endpoint per query; coalesce concurrent reads of the same rows"

api  -> data     : gRPC, routed by consistent hash of channel_id
data -> messages : CQL
data -> hot      : CQL

usecase "Send message" "A user posts a message to a channel" {
  api       -> data     : SendMessage(channel 1046, "gg")
  data     --> api      : message 1129
  data      -> messages : x3 INSERT INTO messages (channel_id, bucket, message_id) at QUORUM
  messages --> data     : ok
}

usecase "Read messages" "A user opens an ordinary channel and loads its latest messages" {
  api       -> data     : GetMessages(channel 2210, limit 50)
  data      -> messages : x2 SELECT FROM messages WHERE channel_id = 2210 AND bucket = 1912 LIMIT 50 at QUORUM
  messages --> data     : 50 rows
  data     --> api      : 50 messages
}

usecase "Read busy channel" "Everyone in a huge server opens the channel that was just pinged" {
  api -> data : GetMessages(channel 1046, limit 50)

  alt "Joined in-flight read" when "a query for this channel is already running on this instance" {
    data --> api : 50 messages, from the shared query
  } alt "First read" when "no query for this channel is in flight" {
    data  -> hot  : x2 SELECT FROM messages WHERE channel_id = 1046 AND bucket = 1912 LIMIT 50 at QUORUM
    hot  --> data : 50 rows
    data --> api  : 50 messages, also to every request that joined
  }
}
