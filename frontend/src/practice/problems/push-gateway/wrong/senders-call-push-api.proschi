# expect-fail: Senders hand messages to Kafka and never call push servers
# expect-fail: p99 of Send < 30 ms
# expect-fail: Send is durable
# No queue: senders call a push API that looks up the connection and delivers before answering, so every sender waits for delivery.
import "problem.proschi"

lb       "Load Balancer"     [AWS Load Balancer] x2 @edge "Layer 4, with a long idle timeout for persistent connections"
push     "Zuul Push Servers" [Java]              x14 @edge "Netty servers holding the WebSocket and SSE connections; each knows its own connections in memory"
registry "Push Registry"     [Redis]             x3 @edge "Dynomite over Redis: customer id to push server, with a TTL"
pushApi  "Push API"          [Java]              x16 @edge "Takes a message, looks the customer up and delivers it"

device  -> lb       : WebSocket / SSE
lb      -> push     : TCP
push    -> registry : RESP
push    -> device   : push frames
senders -> pushApi  : HTTP
pushApi -> registry : RESP
pushApi -> push     : deliver

usecase "Connect" "A device opens its push connection" {
  device    -> lb       : GET /push (Upgrade: websocket)
  lb        -> push     : GET /push (Upgrade: websocket)
  push      -> registry : SET conn:cust-81 push-i-0a1b EX 1800
  registry --> push     : OK
  push     --> lb       : 101 Switching Protocols
  lb       --> device   : 101 Switching Protocols
}

usecase "Send" "A backend service pushes a message to a customer" {
  senders -> pushApi  : POST /push {"customer": "cust-81", "type": "new-recommendations"}
  pushApi -> registry : GET conn:cust-81

  alt "Online" when "the customer has a connection open" {
    registry --> pushApi : push-i-0a1b
    pushApi   -> push    : deliver to cust-81
    push      -> device  : message frame
    push     --> pushApi : delivered
    pushApi  --> senders : 200 delivered
  } alt "Offline" when "no device of the customer is connected" {
    registry --> pushApi : nil
    pushApi  --> senders : 200 dropped
  }
}
