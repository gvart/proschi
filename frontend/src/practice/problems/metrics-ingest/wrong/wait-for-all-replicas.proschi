# expect-fail: A quorum write survives a replica that is down
# mistake: Waiting for every replica on each write
# explain: With one replica down every flush to its shard fails, and in a real cluster some replica is always restarting or being replaced. Write to a quorum, two of three, so one replica down does not stop ingest.
# lesson: quorum-writes
# cards: quorum-read-size, semi-synchronous, sync-vs-async-replication
# Writes wait for all three replicas: one replica down fails every flush to its shard.
import "problem.proschi"

aggregators "M3 Aggregator" [Go] x16 @ingest "Rolls datapoints up in memory by the rules, sharded by series id, and flushes once per resolution"
query       "M3 Query"      [Go] x3 @query "Runs PromQL and M3QL queries against M3DB"

collectors  -> aggregators : batches of datapoints
aggregators -> m3db        : quorum writes
grafana     -> query       : PromQL over HTTP
query       -> m3db        : fetch series

usecase "Emit metrics" "A host sends a batch of datapoints" {
  collectors   -> aggregators : POST /write batch of 2,000 datapoints
  aggregators --> collectors  : 200
}

usecase "Flush aggregates" "At a resolution boundary, an aggregator writes the closed windows to M3DB" {
  alt "All replicas up" when "every replica of the shard answers" {
    aggregators -> m3db        : x3 WRITE 2,000 aggregated datapoints
    m3db       --> aggregators : all acked
  } alt "Replica down" when "one replica of the shard is down" {
    aggregators -> m3db        : x3 WRITE 2,000 aggregated datapoints
    m3db       --> aggregators : 503 consistency level all not met
  }
}

usecase "Query" "A dashboard panel or an alert reads a series" {
  grafana -> query   : GET /api/v1/query_range?query=rate(http_requests_total[1m])
  query   -> m3db    : x2 FETCH series blocks
  m3db   --> query   : datapoints
  query  --> grafana : 200 {"resultType": "matrix"}
}
