# expect-fail: survive any node failure
# mistake: Sizing the replica pool with no room to lose one
# explain: Four replicas carry 60k reads a second at 75% each, which looks fine until one fails: the other three must take 20k each, exactly their capacity, and the pool saturates. Size the pool so that it stays under about 75% with one replica down, here five.
# lesson: sizing-the-replica-pool
# cards: read-replicas-pool-size, three-replicas-parallel
# Four replicas: enough on a good day, saturated the moment one goes down.
import "problem.proschi"

replicas "MySQL Replicas" [MySQL] x4 @data "Read-only copies of the primary"

app     -> proxy    : MySQL protocol
proxy   -> primary  : writes and time-sensitive reads
proxy   -> replicas : reads that tolerate lag
primary -> replicas : binlog replication

usecase "Read catalog" "A storefront page reads products from a replica" {
  app       -> proxy    : SELECT products WHERE shop_id = $1
  proxy     -> replicas : SELECT products WHERE shop_id = $1
  replicas --> proxy    : 40 rows
  proxy    --> app      : 40 rows
}

usecase "Place order" "Checkout writes the order to the primary" {
  app      -> proxy   : INSERT order
  proxy    -> primary : INSERT order
  primary --> proxy   : OK
  proxy   --> app     : OK
}

usecase "Check order" "The order status page reads the order from the primary" {
  app      -> proxy   : SELECT order WHERE id = $1
  proxy    -> primary : SELECT order WHERE id = $1
  primary --> proxy   : 1 row
  proxy   --> app     : 1 row
}
