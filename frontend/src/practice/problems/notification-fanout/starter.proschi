import "problem.proschi"

# Add the components, connections and the use cases "Notify" and "Deliver" with its five scenarios.
notifier "Notifier" [REST API]

orders   -> notifier
notifier -> email

usecase "Notify" {
  orders    -> notifier : OrderShipped {"userId": 42, "orderId": 981}
  notifier  -> email    : send "Your order is on its way"
  email    --> notifier : 202
  notifier --> orders   : 200
}
