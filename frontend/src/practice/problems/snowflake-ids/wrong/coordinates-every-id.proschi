# expect-fail: Each generator claims its worker id once, at startup
# mistake: Asking ZooKeeper on every id
# explain: Coordination lands on the hot path: each id waits for a ZooKeeper round trip, and any hiccup there stalls id generation. Claim the worker id once at startup and make ids locally.
# lesson: coordinate-once-at-startup
# cards: snowflake-id-layout, odd-cluster-size
# The generator checks its worker id with ZooKeeper on every request.
import "problem.proschi"

idgen "Snowflake" [gRPC] x15 @platform "Makes ids from the clock, its worker id and a sequence"

tweets -> idgen : Thrift
idgen  -> zk    : claim worker id

usecase "Get ID" "A service asks for a new id" {
  tweets -> idgen  : GET next id
  idgen  -> zk     : GET /snowflake/workers/37
  zk    --> idgen  : still ours
  idgen --> tweets : 200 {"id": 1541815603606036480}
}

usecase "Start generator" "A generator process starts and claims a worker id" {
  idgen -> zk    : CREATE /snowflake/workers/ ephemeral sequential
  zk   --> idgen : worker id 37
}
