import "problem.proschi"

api      "Recommendations API" [REST API]      x8 @serve "Takes searches and location updates, applies the user's preferences"
router   "Geo Router"          [Service]       x6 @serve "Covers the search circle with S2 cells, maps them to geoshards, fans out and merges"
metro    "Metro Geoshards"     [Elasticsearch] x3 @index "Small geoshards that split the dense metros: 3 geoshards, each with a primary and 2 replicas"
regional "Regional Geoshards"  [Elasticsearch] x3 @index "Large geoshards for everywhere else: 4 geoshards, each with a primary and 2 replicas"
changes  "Location Changes"    [Kafka]         x3 @write "Location changes, partitioned by user id so one user's changes stay in order"
indexer  "Geo Indexer"         [Worker]        x4 @write "Maps the new location to its geoshard and updates the index"

capacity {
  metro    shards 3
  regional shards 4
}

app     -> api      : HTTPS
api     -> router   : gRPC
api     -> profiles : write location
api     -> changes  : produce
router  -> metro    : _search
router  -> regional : _search
changes -> indexer  : consume
indexer -> metro    : index, delete
indexer -> regional : index, delete

entity User in profiles "A user's profile and last known location" {
  userId   int key
  lat      float
  lng      float
  cellId   int
  geoshard string
}

entity UserDocument in metro "A searchable user: location, S2 cell, age and the fields the filters need" {
  userId int key
  cellId int
  lat    float
  lng    float
  age    int
}

entity LocationChange in changes "A user's new location, keyed by user id" {
  userId    int key
  lat       float
  lng       float
  changedAt time
}

decision "Shard the index by location" {
  because "A search only wants users within the searcher's radius, so users who live near each other share a geoshard and a search reads the few geoshards its circle covers"
  rejected "Shard by user id" "Every search must visit every shard and merge, so each shard serves every query and adding shards adds no query capacity"
  rejected "One index for everyone" "Every search scans users on other continents that it then filters out"
}
decision "Balance geoshards by load, not by area" {
  because "S2 cells are grouped into geoshards of about equal load (users and searches), so a dense metro is split into several small geoshards while a whole sparse region shares one"
  rejected "Equal-area geoshards" "The cell over a big city holds a large share of the users and searches; its geoshard runs hot while rural geoshards sit idle"
}
decision "Size each geoshard group for its own load" because "The metro geoshards take 40% of the searches on less than 1% of the land; they get their own shards and replicas"
decision "Update the index from a stream" {
  because "The user's write is the profile; the index follows a moment later, so a busy geoshard never slows a location update"
  rejected "Write the geoshard inside the update" "A move between geoshards is a delete and an insert on two indexes inside the user's request"
}
decision "Partition location changes by user id" because "One user's changes reach one consumer in order, so a quick trip back and forth cannot leave the user in the wrong geoshard"

usecase "Recommend" "A user opens the app and gets people within their search radius" {
  app -> api    : GET /recs?radius=50mi
  api -> router : Search(lat 40.73, lng -73.99, radius 50mi, age 25-35)

  alt "Dense metro" when "the searcher's circle lies in a dense metro" {
    router -> metro  : x3 _search users in the covering S2 cells, filtered by age
    metro --> router : candidates
  } alt "Elsewhere" when "the searcher's circle lies in a sparse region" {
    router    -> regional : x3 _search users in the covering S2 cells, filtered by age
    regional --> router   : candidates
  }

  router --> api : merged candidates
  api    --> app : 200 recommendations
}

usecase "Update location" "The app reports where the user is now" {
  app       -> api      : PUT /me/location {"lat": 40.73, "lng": -73.99}
  api       -> profiles : UpdateItem user 7731 SET lat, lng, cellId
  profiles --> api      : ok
  api      ->> changes  : PUBLISH LocationChanged user 7731
  api      --> app      : 204
}

usecase "Index location" "The indexer puts the user in the geoshard that owns their S2 cell" {
  changes -> indexer : LocationChanged user 7731

  alt "Dense metro" when "the user stayed in a metro geoshard" {
    indexer -> metro   : UPSERT user 7731 with its new cell
    metro  --> indexer : ok
  } alt "Elsewhere" when "the user stayed in a regional geoshard" {
    indexer   -> regional : UPSERT user 7731 with its new cell
    regional --> indexer  : ok
  } alt "Moved geoshard" when "the new cell belongs to another geoshard" {
    indexer   -> regional : DELETE user 7731 from the old geoshard
    regional --> indexer  : ok
    indexer   -> metro    : UPSERT user 7731 into the new geoshard
    metro    --> indexer  : ok
  }

  indexer --> changes : commit offset
}
