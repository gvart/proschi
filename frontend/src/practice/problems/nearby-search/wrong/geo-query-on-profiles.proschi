# expect-fail: Searches go through the geo router
# mistake: Answering nearby searches from the profile database
# explain: A query for everyone within 50 miles is a range search over two coordinates, which a key-value profile store can only answer by scanning, and every search then competes with the location writes on the source of truth.
# explain: Keep the profiles for writes, and answer searches from a location-sharded search index behind a geo router.
# lesson: search-the-index-not-the-database
# cards: inverted-index, geohash-neighbours, oltp-vs-olap
# The API scans the profile table for users within the radius; the geoshards are kept up to date, and nobody searches them.
import "problem.proschi"

api      "Recommendations API" [REST API]      x8 @serve "Searches the profile table by latitude and longitude"
metro    "Metro Geoshards"     [Elasticsearch] x3 @index "Small geoshards that split the dense metros"
regional "Regional Geoshards"  [Elasticsearch] x3 @index "Large geoshards for everywhere else"
changes  "Location Changes"    [Kafka]         x3 @write "Location changes, partitioned by user id"
indexer  "Geo Indexer"         [Worker]        x4 @write "Updates the geoshard that owns the user's cell"

capacity {
  metro    shards 3
  regional shards 4
}

app     -> api      : HTTPS
api     -> profiles : query, write location
api     -> changes  : produce
changes -> indexer  : consume
indexer -> metro    : index, delete
indexer -> regional : index, delete

usecase "Recommend" "A user opens the app and gets people within their search radius" {
  app       -> api      : GET /recs?radius=50mi
  api       -> profiles : SCAN users WHERE lat BETWEEN 40.0 AND 41.4 AND lng BETWEEN -74.9 AND -73.0
  profiles --> api      : candidates

  alt "Dense metro" {
    api --> app : 200 recommendations
  } alt "Elsewhere" {
    api --> app : 200 recommendations
  }
}

usecase "Update location" "The app reports where the user is now" {
  app      -> api      : PUT /me/location {"lat": 40.73, "lng": -73.99}
  api      -> profiles : UPDATE user 7731 SET lat, lng, cellId
  api     ->> changes  : PUBLISH LocationChanged user 7731
  api     --> app      : 204
}

usecase "Index location" "The indexer puts the user in the geoshard that owns their S2 cell" {
  changes -> indexer : LocationChanged user 7731

  alt "Dense metro" {
    indexer -> metro : UPSERT user 7731
  } alt "Elsewhere" {
    indexer -> regional : UPSERT user 7731
  } alt "Moved geoshard" {
    indexer -> regional : DELETE user 7731 from the old geoshard
    indexer -> metro    : UPSERT user 7731 into the new geoshard
  }

  indexer --> changes : commit offset
}
