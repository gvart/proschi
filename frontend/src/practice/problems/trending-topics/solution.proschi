import "problem.proschi"

firehose "Firehose"       [Kafka]             x3 @trends "Every new tweet as an event, partitioned by term after extraction"
detector "Trend Detector" [Java]              x16 @trends "Summingbird on Storm: counts terms per location in sliding windows, in memory"
cache    "Trends Cache"   [Redis]             x2 @trends "The ranked trends list of every location"
trendsdb "Trends Store"   [MySQL]             x2 @trends "The last published list per location, to refill the cache"
lb       "Load Balancer"  [AWS Load Balancer] x2 @platform
api      "Trends API"     [REST API]          x24 @trends "Serves a location's trends list"

tweets   -> firehose : produce
firehose -> detector : consume
detector -> cache    : SET
detector -> trendsdb : SQL
user     -> lb       : HTTPS
lb       -> api      : HTTPS
api      -> cache    : RESP
api      -> trendsdb : SQL

entity TrendList in trendsdb "The ranked trends of one location, published every few seconds" {
  locationId  int key
  trends      json
  publishedAt time
}

decision "Count in the stream, off the tweet's write path" {
  because "Posting a tweet only hands an event to the firehose; counting can fall behind during a spike without slowing a single post down"
  rejected "Increment counters while posting" "Every tweet would wait for a counter store, and a spike of 25 times the normal rate would hit it head on"
}
decision "Keep the windows in the detector's memory" {
  because "Each tweet touches a dozen counters (terms times locations); a count-min sketch and a top-K heap per window and location take those updates in memory, and only the ranked result leaves the detector"
  rejected "A counter per term in Redis or a database" "Hundreds of thousands of increments a second on a shared store, to answer a question that needs only the top fifty"
}
decision "Rank ahead of time, serve from a cache" {
  because "A trends request reads one precomputed list: the work is done once per location every five seconds, not once per reader"
  rejected "Count at read time over the tweet store" "A GROUP BY over the last hour of tweets for every one of 30k reads a second"
}
decision "Trend = unusual growth, not volume" because "Ranking compares each term's recent count with its own baseline, so a term that is always popular does not crowd out one that is spiking"

usecase "Post tweet" "A user posts a tweet" {
  user        -> tweets     : POST /tweets json {"text": "Watching the #WorldCup final"}
  tweets      -> tweetstore : INSERT tweet
  tweetstore --> tweets     : ok
  tweets     ->> firehose   : PRODUCE TweetCreated
  tweets     --> user       : 201 {"id": 1541815603606036480}
}

usecase "Count tweet" "The detector adds a tweet's terms to its windows" {
  firehose  -> detector : TweetCreated 1541815603606036480
  detector --> firehose : commit offset
}

usecase "Publish trends" "Every five seconds, a location's trends are ranked and published" {
  detector  -> cache    : SET trends:23424977 top 50
  cache    --> detector : ok
  detector  -> trendsdb : UPSERT trend_lists 23424977
  trendsdb --> detector : ok
}

usecase "Get trends" "A user opens a location's trends" {
  user -> lb  : GET /trends/23424977
  lb   -> api : GET /trends/23424977

  alt "Cache hit" when "the location's list is in Redis" {
    api    -> cache : GET trends:23424977
    cache --> api   : top 50
  } alt "Cache miss" when "Redis lost the list" {
    api       -> cache    : GET trends:23424977
    cache    --> api      : nil
    api       -> trendsdb : SELECT trends FROM trend_lists
    trendsdb --> api      : top 50
    api       -> cache    : SET trends:23424977 top 50
    cache    --> api      : ok
  }
  api --> lb   : 200 {"trends": ["#WorldCup", "Messi"]}
  lb  --> user : 200 {"trends": ["#WorldCup", "Messi"]}
}
