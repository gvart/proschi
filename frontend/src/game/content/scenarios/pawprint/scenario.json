          "to": "db",
          "entity": "Sitter"
        },
        {
          "op": "write",
          "to": "db",
          "entity": "Booking"
        },
        {
          "op": "write",
          "to": "db",
          "entity": "BookingPet",
          "x": 2
        },
        {
          "op": "call",
          "to": "mail",
          "async": true
        }
      ]
    },
    "bookings": {
      "name": "My bookings",
      "method": "GET",
