{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "5b0b889b73685bd77e4911488cd9d9028c87ca6a",
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "tooling",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Performance" },
        { "type": "chore", "section": "Miscellaneous", "hidden": true },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "refactor", "section": "Refactoring", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true }
      ],
      "extra-files": [
        { "type": "json", "path": "tooling/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "tooling/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "tooling/package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "json", "path": "tooling/vscode/package.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "tooling/jetbrains/gradle.properties" },
        { "type": "json", "path": "plugin/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".claude-plugin/marketplace.json", "jsonpath": "$.plugins[0].version" }
      ]
    }
  }
}
