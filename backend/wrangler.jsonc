// proschi.app: the site (frontend/dist) and its API, sign-in and practice stats (backend/README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proschi",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  // Verifying solutions runs the simulation: 3–12 ms of CPU per problem, a
  // whole import of them more. Needs Workers Paid; Free caps a request at 10 ms.
  "limits": { "cpu_ms": 1000 },
  // Fonts of the Open Graph images (src/og.ts), imported as bytes; .wasm is compiled at upload by default.
  "rules": [{ "type": "Data", "globs": ["**/*.woff"], "fallthrough": true }],
  "routes": [{ "pattern": "proschi.app", "custom_domain": true }],
  // `wrangler dev` would otherwise rewrite requests to the route's host, so
  // OAuth callbacks and the same-origin check would see proschi.app.
  "dev": { "host": "localhost:8787", "upstream_protocol": "http" },
  // The built site: `npm run build` in frontend/ first. Paths outside /api, /auth,
  // /s (short links, src/shares.ts), /u (public profile pages, src/profilePage.ts)
  // and /share (live share links, src/documentShares.ts) are served straight
  // from these files, without running the Worker.
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/s/*", "/u/*", "/share/*"],
    "not_found_handling": "404-page"
  },
  // Hourly: the email reminders of users whose local time it is (src/reminders.ts);
  // in the 03:xx UTC run also delete expired sessions, abandoned game runs,
  // usage counts older than 400 days and old diagram tombstones (src/cron.ts).
  "triggers": { "crons": ["17 * * * *"] },
  // Cloudflare Email Service: the reminder and confirmation emails (src/email.ts).
  // proschi.app must be onboarded to Email Service (backend/README.md "Email reminders").
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["reminders@proschi.app"] }],
  // APP_REDIRECT_URIS: where native apps may be sent back to after signing in
  // (exact URIs, comma-separated; README "Mobile apps"). Empty: app sign-in is off.
  "vars": { "ENVIRONMENT": "production", "APP_REDIRECT_URIS": "" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proschi",
      // `npx wrangler d1 create proschi` prints this id; it is not a secret.
      "database_id": "aa25969d-1e0d-489d-8a1d-427b4176c224",
      "migrations_dir": "migrations"
    }
  ],
  // Per minute: test runs (they run the simulation), account changes,
  // progress uploads, card review requests, daily challenge attempts, short links, synced diagram
  // requests and reminder confirmation emails per user;
  // sign-ins, stats, usage counts (POST /api/metrics) and admin sign-in steps per IP.
  "ratelimits": [
    { "name": "RUN_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "PROFILE_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "STATS_LIMITER", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } },
    { "name": "IMPORT_LIMITER", "namespace_id": "1005", "simple": { "limit": 3, "period": 60 } },
    { "name": "REVIEW_LIMITER", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } },
    { "name": "CARD_LIMITER", "namespace_id": "1007", "simple": { "limit": 60, "period": 60 } },
    { "name": "CHALLENGE_LIMITER", "namespace_id": "1008", "simple": { "limit": 10, "period": 60 } },
    { "name": "GAME_LIMITER", "namespace_id": "1009", "simple": { "limit": 20, "period": 60 } },
    { "name": "METRICS_LIMITER", "namespace_id": "1010", "simple": { "limit": 30, "period": 60 } },
    { "name": "SHARE_LIMITER", "namespace_id": "1011", "simple": { "limit": 10, "period": 60 } },
    { "name": "DOCS_LIMITER", "namespace_id": "1012", "simple": { "limit": 120, "period": 60 } },
    { "name": "EMAIL_LIMITER", "namespace_id": "1013", "simple": { "limit": 3, "period": 60 } },
    { "name": "ADMIN_LIMITER", "namespace_id": "1014", "simple": { "limit": 30, "period": 60 } },
    // AI design reviews per user (src/review.ts); the daily cap is counted in D1.
    { "name": "AI_REVIEW_LIMITER", "namespace_id": "1015", "simple": { "limit": 5, "period": 60 } },
    // AI interviews per user (src/interviews.ts): sessions started, turns, verdicts and reads.
    { "name": "INTERVIEW_START_LIMITER", "namespace_id": "1016", "simple": { "limit": 5, "period": 60 } },
    { "name": "INTERVIEW_TURN_LIMITER", "namespace_id": "1017", "simple": { "limit": 20, "period": 60 } },
    { "name": "INTERVIEW_FINISH_LIMITER", "namespace_id": "1018", "simple": { "limit": 5, "period": 60 } },
    { "name": "INTERVIEW_READ_LIMITER", "namespace_id": "1019", "simple": { "limit": 60, "period": 60 } },
    // Polar's webhook, per IP, before the signature is checked (src/billing.ts): generous, Polar sends from few addresses and
    // retries; and at most one logged bad signature per IP a minute, so the log isn't a free write for anyone.
    { "name": "WEBHOOK_LIMITER", "namespace_id": "1020", "simple": { "limit": 300, "period": 60 } },
    { "name": "WEBHOOK_LOG_LIMITER", "namespace_id": "1021", "simple": { "limit": 1, "period": 60 } },
    // Design partner requests per user (src/partner.ts): sessions, turns, reads and change decisions.
    { "name": "PARTNER_LIMITER", "namespace_id": "1030", "simple": { "limit": 30, "period": 60 } }
  ],
  // The deployed version's id and time, for the admin panel's health page (src/admin.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Secrets (`npx wrangler secret put <NAME>`, the dashboard, or .dev.vars locally):
  // SESSION_SECRET (at least 32 characters), GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, METRICS_TOKEN (GET /api/metrics/summary; unset: 404),
  // ADMIN_SETUP_TOKEN (registers the admin panel's first passkey; at least 16 characters)
  // POLAR_ACCESS_TOKEN, POLAR_WEBHOOK_SECRET, POLAR_PRODUCT_PRO_MONTHLY, POLAR_PRODUCT_PRO_YEARLY,
  // POLAR_PRODUCT_MAX_MONTHLY, POLAR_PRODUCT_MAX_YEARLY, POLAR_PRODUCT_CREDITS_1000, optionally
  // CREDITS_USD_EUR (src/meter.ts; unset: 0.95) and, against Polar's sandbox, POLAR_SERVER=sandbox (billing, src/billing.ts; unset: 501)
  // ANTHROPIC_API_KEY (the AI interviewer, src/interviews.ts; unset: 501), and through Cloudflare AI Gateway
  // AI_GATEWAY_URL and, for an authenticated gateway, AI_GATEWAY_TOKEN

  "env": {
    // staging.proschi.app: every deploy goes here first (`npm run deploy:staging`).
    // Vars and bindings are not inherited from the top level, so they are repeated.
    // Its secrets are set separately: `npx wrangler secret put <NAME> --env staging`.
    "staging": {
      "name": "proschi-staging",
      "routes": [{ "pattern": "staging.proschi.app", "custom_domain": true }],
      "triggers": { "crons": ["17 * * * *"] },
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["reminders@proschi.app"] }],
      "vars": { "ENVIRONMENT": "staging", "APP_REDIRECT_URIS": "" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "proschi-staging",
          // Replace with the id `npx wrangler d1 create proschi-staging` prints.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "RUN_LIMITER", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "AUTH_LIMITER", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
        { "name": "PROFILE_LIMITER", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
        { "name": "STATS_LIMITER", "namespace_id": "2004", "simple": { "limit": 120, "period": 60 } },
        { "name": "IMPORT_LIMITER", "namespace_id": "2005", "simple": { "limit": 3, "period": 60 } },
        { "name": "REVIEW_LIMITER", "namespace_id": "2006", "simple": { "limit": 10, "period": 60 } },
        { "name": "CARD_LIMITER", "namespace_id": "2007", "simple": { "limit": 60, "period": 60 } },
        { "name": "CHALLENGE_LIMITER", "namespace_id": "2008", "simple": { "limit": 10, "period": 60 } },
        { "name": "GAME_LIMITER", "namespace_id": "2009", "simple": { "limit": 20, "period": 60 } },
        { "name": "METRICS_LIMITER", "namespace_id": "2010", "simple": { "limit": 30, "period": 60 } },
        { "name": "SHARE_LIMITER", "namespace_id": "2011", "simple": { "limit": 10, "period": 60 } },
        { "name": "DOCS_LIMITER", "namespace_id": "2012", "simple": { "limit": 120, "period": 60 } },
        { "name": "EMAIL_LIMITER", "namespace_id": "2013", "simple": { "limit": 3, "period": 60 } },
        { "name": "ADMIN_LIMITER", "namespace_id": "2014", "simple": { "limit": 30, "period": 60 } },
        { "name": "AI_REVIEW_LIMITER", "namespace_id": "2015", "simple": { "limit": 5, "period": 60 } },
        { "name": "INTERVIEW_START_LIMITER", "namespace_id": "2016", "simple": { "limit": 5, "period": 60 } },
        { "name": "INTERVIEW_TURN_LIMITER", "namespace_id": "2017", "simple": { "limit": 20, "period": 60 } },
        { "name": "INTERVIEW_FINISH_LIMITER", "namespace_id": "2018", "simple": { "limit": 5, "period": 60 } },
        { "name": "INTERVIEW_READ_LIMITER", "namespace_id": "2019", "simple": { "limit": 60, "period": 60 } },
        { "name": "WEBHOOK_LIMITER", "namespace_id": "2020", "simple": { "limit": 300, "period": 60 } },
        { "name": "WEBHOOK_LOG_LIMITER", "namespace_id": "2021", "simple": { "limit": 1, "period": 60 } },
        { "name": "PARTNER_LIMITER", "namespace_id": "2030", "simple": { "limit": 30, "period": 60 } }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" }
    }
  }
}
