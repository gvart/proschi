{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gvart.github.io/proschi/schema/proschi-diagram.schema.json",
  "title": "Proschi parse result",
  "description": "Output of `proschi parse <file>`: the diagram a Proschi document describes, plus parser diagnostics.",
  "type": "object",
  "properties": {
    "diagram": {
      "$ref": "#/$defs/diagram"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "required": [
    "diagram",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$defs": {
    "loc": {
      "type": "object",
      "description": "1-based source position.",
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "col": {
          "type": "integer",
          "minimum": 1
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "line",
        "col",
        "length"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "message": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "col": {
          "type": "integer",
          "minimum": 1
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "severity",
        "message",
        "line",
        "col",
        "length"
      ],
      "additionalProperties": false
    },
    "diagram": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "useCases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/useCase"
          }
        }
      },
      "required": [
        "nodes",
        "edges",
        "useCases"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "component",
            "group",
            "text"
          ]
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "shape",
            "service",
            "serverless",
            "compute",
            "container",
            "storage",
            "database",
            "cache",
            "queue",
            "cdn",
            "external",
            "text",
            "group"
          ]
        },
        "techStack": {
          "enum": [
            "Rectangle",
            "Circle",
            "Diamond",
            "Cylinder",
            "Cloud",
            "Actor",
            "Note",
            "REST API",
            "GraphQL",
            "gRPC",
            "WebSocket",
            "SOAP API",
            "AWS Lambda",
            "AWS API Gateway",
            "AWS EC2",
            "AWS ECS",
            "AWS EKS",
            "AWS Fargate",
            "AWS S3",
            "AWS EBS",
            "AWS EFS",
            "AWS RDS",
            "AWS DynamoDB",
            "AWS ElastiCache",
            "AWS Aurora",
            "AWS SQS",
            "AWS SNS",
            "AWS EventBridge",
            "AWS Kinesis",
            "AWS CloudFront",
            "AWS Route53",
            "AWS Load Balancer",
            "GCP Cloud Functions",
            "GCP Cloud Run",
            "GCP App Engine",
            "GCP Compute Engine",
            "GCP GKE",
            "GCP Cloud Storage",
            "GCP Persistent Disk",
            "GCP Cloud SQL",
            "GCP Firestore",
            "GCP Bigtable",
            "GCP Spanner",
            "GCP BigQuery",
            "GCP Pub/Sub",
            "GCP Cloud CDN",
            "GCP Cloud DNS",
            "GCP Load Balancing",
            "Azure Functions",
            "Azure Logic Apps",
            "Azure API Management",
            "Azure VM",
            "Azure AKS",
            "Azure Container Instances",
            "Azure Blob Storage",
            "Azure Files",
            "Azure Disk Storage",
            "Azure SQL",
            "Azure Cosmos DB",
            "Azure Database for PostgreSQL",
            "Azure Database for MySQL",
            "Azure Cache for Redis",
            "Azure Service Bus",
            "Azure Event Hubs",
            "Azure Event Grid",
            "Azure Queue Storage",
            "Azure CDN",
            "Azure DNS",
            "Azure Front Door",
            "PostgreSQL",
            "MySQL",
            "MongoDB",
            "Redis",
            "DynamoDB",
            "Cassandra",
            "CouchDB",
            "Elasticsearch",
            "Neo4j",
            "InfluxDB",
            "TimescaleDB",
            "MariaDB",
            "SQLite",
            "Oracle",
            "SQL Server",
            "Memcached",
            "Hazelcast",
            "Aerospike",
            "Kafka",
            "RabbitMQ",
            "SQS",
            "Redis Queue",
            "NATS",
            "Apache Pulsar",
            "ActiveMQ",
            "ZeroMQ",
            "Third Party API",
            "Payment Gateway",
            "Auth Service",
            "Email Service",
            "SMS Service",
            "Analytics Service",
            "Text Note",
            "Sticky Note",
            "Comment",
            "Logical Group",
            "Network Boundary",
            "Security Zone",
            "Service Group"
          ]
        },
        "ownerTeam": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parent": {
          "type": "string",
          "description": "Id of the enclosing group."
        },
        "position": {
          "type": "object",
          "description": "Explicit `pos x,y`.",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "implicit": {
          "type": "boolean",
          "description": "Created because a connection or step referenced an undeclared id."
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "type",
        "techStack",
        "loc"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "loc"
      ],
      "additionalProperties": false
    },
    "useCase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "entryServiceId": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "description": "`METHOD /path` of the first step, if it is an HTTP call."
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "Steps of the first scenario."
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          },
          "minItems": 1
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "required": [
        "id",
        "name",
        "steps",
        "scenarios",
        "loc"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "error"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "required": [
        "id",
        "name",
        "outcome",
        "steps",
        "loc"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "stepOrder": {
          "type": "integer"
        },
        "stepName": {
          "type": "string"
        },
        "fromServiceId": {
          "type": "string"
        },
        "toServiceId": {
          "type": "string"
        },
        "protocol": {
          "enum": [
            "REST",
            "GRPC",
            "SOAP",
            "GRAPHQL",
            "MESSAGING",
            "OTHER"
          ]
        },
        "httpMethod": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "requestFormat": {
          "enum": [
            "JSON",
            "XML",
            "FREE_TEXT"
          ]
        },
        "requestBody": {
          "type": "string"
        },
        "responseFormat": {
          "enum": [
            "JSON",
            "XML",
            "FREE_TEXT"
          ]
        },
        "responseBody": {
          "type": "string"
        },
        "statusCode": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "executionType": {
          "enum": [
            "SYNC_REQUEST_RESPONSE",
            "ASYNC_FIRE_AND_FORGET",
            "ASYNC_REQUEST_RESPONSE"
          ]
        },
        "parallelGroup": {
          "type": "integer"
        },
        "isParallel": {
          "type": "boolean"
        },
        "isConditional": {
          "type": "boolean"
        },
        "conditionExpression": {
          "type": "string"
        },
        "failed": {
          "type": "boolean",
          "description": "Written `a -x b`: the call never got an answer."
        },
        "loc": {
          "$ref": "#/$defs/loc",
          "description": "The request line."
        },
        "responseLoc": {
          "$ref": "#/$defs/loc",
          "description": "The `-->` line that answered the request."
        }
      },
      "required": [
        "stepOrder",
        "stepName",
        "fromServiceId",
        "toServiceId",
        "protocol",
        "httpMethod",
        "endpoint",
        "requestFormat",
        "responseFormat",
        "executionType",
        "isParallel",
        "isConditional",
        "loc"
      ],
      "additionalProperties": false
    }
  }
}
