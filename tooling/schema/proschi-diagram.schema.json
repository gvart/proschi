{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gvart.github.io/proschi/schema/proschi-diagram.schema.json",
  "title": "Proschi parse result",
  "description": "Output of `proschi parse <file>`: the diagram a Proschi document describes, plus parser diagnostics.",
  "type": "object",
  "properties": {
    "diagram": {
      "$ref": "#/$defs/diagram"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/import"
      },
      "description": "Every `import` statement read, in any file; left out when there are none."
    }
  },
  "required": [
    "diagram",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$defs": {
    "loc": {
      "type": "object",
      "description": "1-based source position.",
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "col": {
          "type": "integer",
          "minimum": 1
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "file": {
          "type": "string",
          "description": "The imported file this is in; left out for the parsed file itself."
        }
      },
      "required": [
        "line",
        "col",
        "length"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "message": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "col": {
          "type": "integer",
          "minimum": 1
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "file": {
          "type": "string",
          "description": "The imported file this is in; left out for the parsed file itself."
        }
      },
      "required": [
        "severity",
        "message",
        "line",
        "col",
        "length"
      ],
      "additionalProperties": false
    },
    "import": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "The path as written."
        },
        "resolved": {
          "type": "string",
          "description": "The file it resolved to; left out when it could not be found."
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "required": [
        "path",
        "loc"
      ],
      "additionalProperties": false
    },
    "diagram": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "useCases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/useCase"
          }
        },
        "summary": {
          "type": "string",
          "description": "Second string of `title`: the system summary."
        },
        "traffic": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traffic"
          },
          "description": "`traffic { … }` lines, one per use case."
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "description": "`requirements { … }` lines."
        },
        "capacity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capacity"
          },
          "description": "`capacity { … }` lines: per-replica overrides of the default profiles."
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          },
          "description": "`entity` blocks: the data model."
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          },
          "description": "`decision` statements."
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test"
          },
          "description": "`test` blocks of flow assertions."
        }
      },
      "required": [
        "nodes",
        "edges",
        "useCases"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "component",
            "group",
            "text"
          ]
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "shape",
            "service",
            "database",
            "cache",
            "queue",
            "storage",
            "cdn",
            "serverless",
            "container",
            "compute",
            "external",
            "text",
            "group"
          ]
        },
        "techStack": {
          "type": "string",
          "description": "A tech stack from the component catalog (see `examples`), or the text of an unknown one, in which case `inferredKind` is set.",
          "examples": [
            "Rectangle",
            "Circle",
            "Diamond",
            "Cylinder",
            "Cloud",
            "Actor",
            "Browser",
            "Mobile App",
            "Note",
            "Service",
            "Worker",
            "Database",
            "NoSQL Database",
            "Cache",
            "Message Queue",
            "Object Storage",
            "CDN",
            "Load Balancer",
            "API Gateway",
            "DNS",
            "WAF",
            "Function",
            "Search Engine",
            "Data Warehouse",
            "REST API",
            "GraphQL",
            "gRPC",
            "WebSocket",
            "SOAP API",
            "Spring Boot",
            "Kotlin",
            "Java",
            "Go",
            "Node.js",
            "Python",
            "Django",
            "FastAPI",
            "Flask",
            "Ruby on Rails",
            ".NET",
            "PHP",
            "Rust",
            "Elixir",
            "Kubernetes",
            "Docker",
            "VM",
            "Cloudflare Workers",
            "AWS Lambda",
            "AWS API Gateway",
            "AWS EC2",
            "AWS ECS",
            "AWS EKS",
            "AWS Fargate",
            "AWS S3",
            "AWS EBS",
            "AWS EFS",
            "AWS RDS",
            "AWS DynamoDB",
            "AWS ElastiCache",
            "AWS Aurora",
            "AWS DocumentDB",
            "AWS Keyspaces",
            "AWS Neptune",
            "AWS Redshift",
            "AWS Athena",
            "AWS OpenSearch",
            "AWS SQS",
            "AWS SNS",
            "AWS EventBridge",
            "AWS Kinesis",
            "AWS MSK",
            "AWS CloudFront",
            "AWS Route53",
            "AWS Load Balancer",
            "AWS WAF",
            "AWS Global Accelerator",
            "AWS SES",
            "AWS Cognito",
            "GCP Cloud Functions",
            "GCP Cloud Run",
            "GCP App Engine",
            "GCP Compute Engine",
            "GCP GKE",
            "GCP Cloud Storage",
            "GCP Persistent Disk",
            "GCP Cloud SQL",
            "GCP Firestore",
            "GCP Bigtable",
            "GCP Spanner",
            "GCP BigQuery",
            "GCP Memorystore",
            "GCP Pub/Sub",
            "GCP Cloud CDN",
            "GCP Cloud DNS",
            "GCP Load Balancing",
            "GCP Apigee",
            "Azure Functions",
            "Azure Logic Apps",
            "Azure API Management",
            "Azure VM",
            "Azure AKS",
            "Azure Container Instances",
            "Azure App Service",
            "Azure Blob Storage",
            "Azure Files",
            "Azure Disk Storage",
            "Azure SQL",
            "Azure Cosmos DB",
            "Azure Database for PostgreSQL",
            "Azure Database for MySQL",
            "Azure Cache for Redis",
            "Azure AI Search",
            "Azure Service Bus",
            "Azure Event Hubs",
            "Azure Event Grid",
            "Azure Queue Storage",
            "Azure CDN",
            "Azure DNS",
            "Azure Front Door",
            "Azure Load Balancer",
            "Azure Application Gateway",
            "PostgreSQL",
            "MySQL",
            "MongoDB",
            "Redis",
            "DynamoDB",
            "Cassandra",
            "CouchDB",
            "Elasticsearch",
            "Neo4j",
            "InfluxDB",
            "TimescaleDB",
            "MariaDB",
            "SQLite",
            "Oracle",
            "SQL Server",
            "CockroachDB",
            "YugabyteDB",
            "TiDB",
            "Vitess",
            "ScyllaDB",
            "Couchbase",
            "HBase",
            "etcd",
            "ZooKeeper",
            "Memcached",
            "Hazelcast",
            "Aerospike",
            "Valkey",
            "KeyDB",
            "Dragonfly",
            "Kafka",
            "RabbitMQ",
            "SQS",
            "Redis Queue",
            "NATS",
            "Apache Pulsar",
            "ActiveMQ",
            "ZeroMQ",
            "Redpanda",
            "OpenSearch",
            "Solr",
            "Meilisearch",
            "Typesense",
            "Algolia",
            "Snowflake",
            "ClickHouse",
            "Apache Druid",
            "Apache Pinot",
            "Databricks",
            "Prometheus",
            "MinIO",
            "Cloudflare R2",
            "Ceph",
            "HDFS",
            "Cloudflare",
            "Fastly",
            "Akamai",
            "nginx",
            "Envoy",
            "HAProxy",
            "Traefik",
            "Kubernetes Ingress",
            "Kong",
            "Spring Cloud Gateway",
            "Third Party API",
            "Payment Gateway",
            "Auth Service",
            "Email Service",
            "SMS Service",
            "Push Service",
            "Analytics Service",
            "Stripe",
            "PayPal",
            "Adyen",
            "Braintree",
            "Twilio",
            "SendGrid",
            "Mailgun",
            "Auth0",
            "Okta",
            "Google Maps",
            "APNs",
            "FCM",
            "OpenAI",
            "Text Note",
            "Sticky Note",
            "Comment",
            "Logical Group",
            "Network Boundary",
            "Security Zone",
            "Service Group"
          ]
        },
        "inferredKind": {
          "enum": [
            "client",
            "edge",
            "cdn",
            "loadbalancer",
            "gateway",
            "dns",
            "service",
            "function",
            "cache",
            "database",
            "search",
            "analytics",
            "queue",
            "storage",
            "external",
            "other"
          ],
          "description": "Only for a tech the catalog does not know: the kind the simulation gives the node, from the words in its name."
        },
        "ownerTeam": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parent": {
          "type": "string",
          "description": "Id of the enclosing group."
        },
        "position": {
          "type": "object",
          "description": "Explicit `pos x,y`.",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "implicit": {
          "type": "boolean",
          "description": "Created because a connection or step referenced an undeclared id."
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "description": "`x3`: number of replicas; absent means 1."
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "type",
        "techStack",
        "loc"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "loc"
      ],
      "additionalProperties": false
    },
    "useCase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "entryServiceId": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "description": "`METHOD /path` of the first step, if it is an HTTP call."
        },
        "endpointGroup": {
          "type": "string",
          "description": "The endpoint with concrete ids folded into a `{param}` path template; use cases that share it hit the same endpoint."
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "Steps of the first scenario."
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          },
          "minItems": 1
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "required": [
        "id",
        "name",
        "steps",
        "scenarios",
        "loc"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "error"
          ]
        },
        "condition": {
          "type": "string",
          "description": "`when \"…\"` conditions of the branches on the scenario's path, joined with ' · '."
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "required": [
        "id",
        "name",
        "outcome",
        "steps",
        "loc"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "stepOrder": {
          "type": "integer"
        },
        "stepName": {
          "type": "string"
        },
        "fromServiceId": {
          "type": "string"
        },
        "toServiceId": {
          "type": "string"
        },
        "protocol": {
          "enum": [
            "REST",
            "GRPC",
            "SOAP",
            "GRAPHQL",
            "MESSAGING",
            "OTHER"
          ]
        },
        "httpMethod": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "requestFormat": {
          "enum": [
            "JSON",
            "XML",
            "FREE_TEXT"
          ]
        },
        "requestBody": {
          "type": "string"
        },
        "responseFormat": {
          "enum": [
            "JSON",
            "XML",
            "FREE_TEXT"
          ]
        },
        "responseBody": {
          "type": "string"
        },
        "statusCode": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "executionType": {
          "enum": [
            "SYNC_REQUEST_RESPONSE",
            "ASYNC_FIRE_AND_FORGET",
            "ASYNC_REQUEST_RESPONSE"
          ]
        },
        "parallelGroup": {
          "type": "integer"
        },
        "isParallel": {
          "type": "boolean"
        },
        "isConditional": {
          "type": "boolean"
        },
        "conditionExpression": {
          "type": "string"
        },
        "failed": {
          "type": "boolean",
          "description": "Written `a -x b`: the call never got an answer."
        },
        "loc": {
          "$ref": "#/$defs/loc",
          "description": "The request line."
        },
        "responseLoc": {
          "$ref": "#/$defs/loc",
          "description": "The `-->` line that answered the request."
        },
        "multiplier": {
          "type": "integer",
          "minimum": 1,
          "description": "`x200` at the start of the label: the step happens this many times per request (fan-out). Absent means 1."
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "description": "`~2MB` at the start of the label: payload size in bytes (decimal units)."
        },
        "access": {
          "enum": [
            "read",
            "write"
          ],
          "description": "From the HTTP method, or the first word of the label (INSERT, SET, PUBLISH, … write); every request step has one."
        }
      },
      "required": [
        "stepOrder",
        "stepName",
        "fromServiceId",
        "toServiceId",
        "protocol",
        "httpMethod",
        "endpoint",
        "requestFormat",
        "responseFormat",
        "executionType",
        "isParallel",
        "isConditional",
        "access",
        "loc"
      ],
      "additionalProperties": false
    },
    "selector": {
      "description": "A node id, an exact tech stack, every node of a kind (`any cache`), every data store of a consistency (`any strong store`), or a union (`X or Y`).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "node": {
              "type": "string"
            }
          },
          "required": [
            "node"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tech": {
              "type": "string"
            }
          },
          "required": [
            "tech"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "client",
                "edge",
                "cdn",
                "loadbalancer",
                "gateway",
                "dns",
                "service",
                "function",
                "cache",
                "database",
                "search",
                "analytics",
                "queue",
                "storage",
                "external",
                "other"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "consistency": {
              "enum": [
                "strong",
                "eventual"
              ]
            }
          },
          "required": [
            "consistency"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "anyOf": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/selector"
              },
              "minItems": 2
            }
          },
          "required": [
            "anyOf"
          ],
          "additionalProperties": false
        }
      ]
    },
    "traffic": {
      "type": "object",
      "properties": {
        "useCase": {
          "type": "string"
        },
        "rps": {
          "type": "number",
          "minimum": 0,
          "description": "Requests per second."
        },
        "mix": {
          "type": "array",
          "description": "Shares of the use case traffic per scenario, as fractions that add up to 1. Without a mix, all traffic goes to the first scenario.",
          "items": {
            "type": "object",
            "properties": {
              "scenario": {
                "type": "string",
                "description": "Full scenario name, e.g. `A › B`."
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "scenario",
              "share"
            ],
            "additionalProperties": false
          }
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "required": [
        "useCase",
        "rps",
        "loc"
      ],
      "additionalProperties": false
    },
    "requirement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "latency"
            },
            "percentile": {
              "enum": [
                50,
                90,
                95,
                99,
                99.9
              ]
            },
            "useCase": {
              "type": "string",
              "description": "Left out: every use case with traffic."
            },
            "scenario": {
              "type": "string",
              "description": "`scenario \"S\"`: the latency of one scenario of the use case."
            },
            "maxMs": {
              "type": "number"
            },
            "loc": {
              "$ref": "#/$defs/loc"
            }
          },
          "required": [
            "kind",
            "percentile",
            "maxMs",
            "loc"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "availability"
            },
            "useCase": {
              "type": "string"
            },
            "minPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "loc": {
              "$ref": "#/$defs/loc"
            }
          },
          "required": [
            "kind",
            "minPercent",
            "loc"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "durable"
            },
            "useCase": {
              "type": "string"
            },
            "loc": {
              "$ref": "#/$defs/loc"
            }
          },
          "required": [
            "kind",
            "useCase",
            "loc"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "survive"
            },
            "target": {
              "oneOf": [
                {
                  "const": "any"
                },
                {
                  "$ref": "#/$defs/selector"
                }
              ]
            },
            "loc": {
              "$ref": "#/$defs/loc"
            }
          },
          "required": [
            "kind",
            "target",
            "loc"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cost"
            },
            "maxUsdPerMonth": {
              "type": "number"
            },
            "loc": {
              "$ref": "#/$defs/loc"
            }
          },
          "required": [
            "kind",
            "maxUsdPerMonth",
            "loc"
          ],
          "additionalProperties": false
        }
      ]
    },
    "capacity": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string"
        },
        "rps": {
          "type": "number",
          "description": "Requests per second per replica."
        },
        "latencyMs": {
          "type": "number"
        },
        "availability": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "costUsd": {
          "type": "number",
          "description": "Monthly cost per replica in USD."
        },
        "durable": {
          "type": "boolean",
          "description": "`durable` (true) or `volatile` (false)."
        },
        "readRps": {
          "type": "number",
          "description": "`reads`: read requests per second per replica."
        },
        "writeRps": {
          "type": "number",
          "description": "`writes`: write requests per second per replica."
        },
        "shards": {
          "type": "integer",
          "minimum": 1,
          "description": "Write capacity of single-primary stores scales with shards."
        },
        "consistency": {
          "enum": [
            "strong",
            "eventual"
          ]
        },
        "bandwidthMBps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "`bandwidth`: megabytes per second per replica."
        },
