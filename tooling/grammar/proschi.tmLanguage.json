{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Proschi",
  "scopeName": "source.proschi",
  "fileTypes": [
    "proschi"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#section"
    },
    {
      "include": "#decision-line"
    },
    {
      "include": "#label"
    },
    {
      "include": "#alt-condition"
    },
    {
      "include": "#import"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#node-id"
    },
    {
      "include": "#string"
    },
    {
      "include": "#tech"
    },
    {
      "include": "#team"
    },
    {
      "include": "#arrow"
    },
    {
      "include": "#position"
    },
    {
      "include": "#replicas"
    },
    {
      "include": "#brace"
    },
    {
      "include": "#identifier"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.proschi",
      "match": "(?:^|(?<=\\s))#.*$"
    },
    "alt-condition": {
      "comment": "`when` is a keyword only between an alt name and its condition: `alt \"Name\" when \"condition\" {`.",
      "match": "^\\s*(?:(\\})\\s*)?(alt)\\s+(?:(\"(?:[^\"\\\\]|\\\\.)*\")|([A-Za-z_][A-Za-z0-9_]*))\\s+(when)\\b",
      "captures": {
        "1": {
          "name": "punctuation.section.block.end.proschi"
        },
        "2": {
          "name": "keyword.control.proschi"
        },
        "3": {
          "patterns": [
            {
              "include": "#string"
            }
          ]
        },
        "4": {
          "name": "variable.other.node.proschi"
        },
        "5": {
          "name": "keyword.control.proschi"
        }
      }
    },
    "import": {
      "comment": "import \"path\": the path is a link to another .proschi file.",
      "match": "^\\s*(import)\\b(?:\\s+(\")([^\"]*)(\")?)?",
      "captures": {
        "1": {
          "name": "keyword.control.import.proschi"
        },
        "2": {
          "name": "punctuation.definition.string.begin.proschi"
        },
        "3": {
          "name": "string.quoted.double.path.proschi"
        },
        "4": {
          "name": "punctuation.definition.string.end.proschi"
        }
      }
    },
    "keyword": {
      "comment": "Statement keywords start a line, or follow } as in `} alt \"Next\" {`.",
      "match": "^\\s*(?:(\\})\\s*)?(title|group|usecase|par|alt)\\b",
      "captures": {
        "1": {
          "name": "punctuation.section.block.end.proschi"
        },
        "2": {
          "name": "keyword.control.proschi"
        }
      }
    },
    "position": {
      "match": "\\b(pos)\\s+(-?\\d+)\\s*(,)\\s*(-?\\d+)",
      "captures": {
        "1": {
          "name": "keyword.other.pos.proschi"
        },
        "2": {
          "name": "constant.numeric.proschi"
        },
        "3": {
          "name": "punctuation.separator.comma.proschi"
        },
        "4": {
          "name": "constant.numeric.proschi"
        }
      }
    },
    "string": {
      "name": "string.quoted.double.proschi",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.proschi"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.proschi"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.proschi",
          "match": "\\\\."
        }
      ]
    },
    "tech": {
      "name": "entity.name.type.tech.proschi",
      "match": "\\[[^\\]\\n]*\\]?"
    },
    "team": {
      "name": "entity.other.attribute-name.team.proschi",
      "match": "@[A-Za-z0-9_-]*"
    },
    "arrow": {
      "name": "keyword.operator.arrow.proschi",
      "match": "->>|-->|->|-x(?![A-Za-z0-9_])"
    },
    "brace": {
      "name": "punctuation.section.block.proschi",
      "match": "[{}]"
    },
    "identifier": {
      "name": "variable.other.node.proschi",
      "match": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "label": {
      "comment": "Everything after ':' on a connection or step line. A JSON payload may continue over several lines until its brackets balance.",
      "name": "meta.label.proschi",
      "begin": ":",
      "end": "$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.separator.label.proschi"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "comment": "`x200` (fan-out) and `~2MB` (payload size) at the start of a step label, in either order.",
          "match": "\\G\\s*(x\\d+|~\\d+(?:\\.\\d+)?[KMGT]?B)(?=\\s|$)(?:\\s+(x\\d+|~\\d+(?:\\.\\d+)?[KMGT]?B)(?=\\s|$))?",
          "captures": {
            "1": {
              "name": "constant.numeric.label-prefix.proschi"
            },
            "2": {
              "name": "constant.numeric.label-prefix.proschi"
            }
          }
        },
        {
          "include": "#payload"
        },
        {
          "match": "\\b(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\\b(?:\\s+(\\S+))?",
          "captures": {
            "1": {
              "name": "keyword.other.http-method.proschi"
            },
            "2": {
              "name": "string.unquoted.endpoint.proschi"
            }
          }
        },
        {
          "comment": "A leading three-digit number on a response is its status code.",
          "match": "\\G\\s*([1-5]\\d\\d)\\b",
          "captures": {
            "1": {
              "name": "constant.numeric.status.proschi"
            }
          }
        },
        {
          "name": "storage.type.format.proschi",
          "match": "\\b(json|xml|text)\\b"
        },
        {
          "include": "#string"
        }
      ]
    },
    "payload": {
      "patterns": [
        {
          "name": "meta.structure.dictionary.proschi",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.dictionary.begin.proschi"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.dictionary.end.proschi"
            }
          },
          "patterns": [
            {
              "include": "#json"
            }
          ]
        },
        {
          "name": "meta.structure.array.proschi",
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.array.begin.proschi"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.array.end.proschi"
            }
          },
          "patterns": [
            {
              "include": "#json"
            }
          ]
        }
      ]
    },
    "json": {
      "patterns": [
        {
          "include": "#payload"
        },
        {
          "name": "string.quoted.double.json.proschi",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.proschi",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.numeric.json.proschi",
          "match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.language.json.proschi",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "punctuation.separator.json.proschi",
          "match": "[,:]"
        }
      ]
    },
    "node-id": {
      "comment": "The id that starts a node declaration or connection.",
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "variable.other.node.proschi"
        }
      }
    },
    "replicas": {
      "comment": "`x3` after a node id: its replica count.",
      "name": "constant.numeric.replicas.proschi",
      "match": "(?<=\\s)x\\d+(?![A-Za-z0-9_])"
    },
    "section": {
      "comment": "traffic, requirements, capacity, entity, decision and test blocks: top level, opened by a header line that ends with {, closed by a line starting with }.",
      "name": "meta.block.section.proschi",
      "begin": "^\\s*(?:(traffic|requirements|capacity)(?=\\s*\\{)|(entity)(?=\\s+[A-Za-z_])|(decision|test)(?=\\s+\"))(?=.*\\{\\s*(?:#.*)?$)",
      "end": "^\\s*(\\})",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.proschi"
        },
        "2": {
          "name": "keyword.control.proschi"
        },
        "3": {
          "name": "keyword.control.proschi"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.section.block.end.proschi"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#tech"
        },
        {
          "include": "#section-keyword"
        },
        {
          "include": "#quantity"
        },
        {
          "name": "keyword.operator.comparison.proschi",
          "match": "[<>]=?"
        },
        {
          "name": "punctuation.separator.comma.proschi",
          "match": ","
        },
        {
          "name": "punctuation.section.block.begin.proschi",
          "match": "\\{"
        },
        {
          "include": "#identifier"
        }
      ]
    },
    "decision-line": {
      "comment": "The one-line decision \"Title\" because \"Reason\".",
      "begin": "^\\s*(decision)(?=\\s+\"(?:[^\"\\\\]|\\\\.)*\"\\s+because\\b)",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.proschi"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#section-keyword"
        }
      ]
    },
    "section-keyword": {
      "name": "keyword.other.proschi",
      "match": "\\b(?:traffic|requirements|capacity|entity|decision|test|mix|durable|volatile|survive|because|rejected|calls|before|after|never|every|waits|for|starts|at|or|responds|writes|reads|responding|handles|failure|path|replicas|any|strong|eventual|store|in|scenario|latency|availability|cost|shards|consistency|bandwidth|egress|timeout|no|from|to|has|of|node|key|index|unique|optional|p50|p90|p95|p99|p999)\\b"
    },
    "quantity": {
      "comment": "A number with an optional fraction, magnitude and unit, attached or one space away: 120, 2.5, 50ms, 100k rps, 99.9%, 4xx, 500 MB/s, 0.05 usd/GB.",
      "name": "constant.numeric.proschi",
      "match": "\\b\\d+(?:\\.\\d+)?(?:[A-Za-z]+(?:/[A-Za-z]+)?|%)?(?: (?:rps|rpm|rpd|ms|s|usd/month|usd/GB|MB/s|GB/s)\\b| %)?"
    }
  }
}
