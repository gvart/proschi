{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    // The renderer (and share-link) pull frontend files (layout, icons, share links) that import these; resolve
    // them from tooling/node_modules so the tooling builds without frontend/node_modules.
    "paths": {
      "elkjs/*": ["./node_modules/elkjs/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "react-icons/*": ["./node_modules/react-icons/*"],
      "lucide-react": ["./node_modules/lucide-react"],
      "lz-string": ["./node_modules/lz-string"]
    }
  },
  "include": ["src", "test", "vscode/src", "build.mjs", "vitest.config.ts"]
}
